{
  "name": "toybox",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build web/main.ts --outdir dist --minify && cp web/index.html web/public/* node_modules/manifold-3d/manifold.wasm dist/",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate",
    "start": "bun run build && bun src/server.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "mancha": "0.30.0",
    "manifold-3d": "3.5.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/three": "0.187.0",
    "typescript": "^7.0.2"
  }
}
